# Copy this file to .env and add your Gemini API key.
# Get a Gemini API key from Google AI Studio / Google Cloud.
GEMINI_API_KEY=your_api_key_here

# Current default model. You can change this if your API account supports another model.
GEMINI_MODEL=gemini-2.5-flash

# Optional local settings
PORT=5000
FLASK_DEBUG=1
